---
interface Props {
  posts: any[];
  currentPage: number;
  totalPages: number;
  prevUrl: string | null;
  nextUrl: string | null;
}

const { posts, currentPage, totalPages, prevUrl, nextUrl } = Astro.props;

const pages = Array.from({ length: totalPages }, (_, i) => i + 1);
---

<div class="space-y-6">
  {posts.map((post) => {
    const slug = post.id.replace(/^\d{4}-\d{1,2}-\d{1,2}-/, '');
    const formattedDate = post.data.date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });

    return (
      <article class="craft-card bg-white border border-zinc-200/80 hover:border-zinc-300 rounded-xl p-6 lg:p-8 shadow-sm hover:shadow transition-all group">
        <div class="flex items-center justify-between gap-3 mb-3">
          <time
            class="font-mono text-xs font-medium text-zinc-600"
            datetime={post.data.date.toISOString().split('T')[0]}
          >
            {formattedDate}
          </time>
          <div class="flex flex-wrap gap-1.5">
            {post.data.categories?.map((category: string) => (
              <a
                class="px-2.5 py-0.5 text-[11px] font-mono font-medium text-zinc-700 bg-zinc-100/90 hover:bg-zinc-200/90 border border-zinc-200/60 rounded-full transition-colors"
                href={`/categories/#${encodeURIComponent(category)}`}
                title={category}
              >
                {category}
              </a>
            ))}
          </div>
        </div>

        <a href={`/${slug}/`} class="block group/title">
          <h2 class="text-2xl font-bold tracking-tight text-zinc-900 group-hover/title:text-blue-600 transition-colors leading-snug">
            {post.data.title}
          </h2>
          {post.data.description && (
            <p class="mt-2.5 text-zinc-600 text-base leading-relaxed line-clamp-2">
              {post.data.description}
            </p>
          )}
        </a>

        <div class="mt-6 pt-5 border-t border-zinc-100 flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap gap-2 text-xs font-mono text-zinc-500">
            {post.data.tags?.map((tag: string) => (
              <a
                href={`/tags/#${encodeURIComponent(tag)}`}
                class="hover:text-zinc-900 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>

          <a
            href={`/${slug}/`}
            class="text-xs font-semibold text-blue-600 hover:text-blue-700 hover:underline inline-flex items-center gap-1 group-hover:translate-x-0.5 transition-transform"
          >
            Read article &rarr;
          </a>
        </div>
      </article>
    );
  })}
</div>

<!-- Pagination Controls -->
{totalPages > 1 && (
  <nav class="flex justify-center items-center mt-12 pt-8 border-t border-zinc-200/80" aria-label="Blog pagination">
    <div class="inline-flex rounded-lg shadow-sm gap-1.5">
      {prevUrl ? (
        <a
          href={prevUrl}
          class="craft-button px-3.5 py-2 text-sm font-medium text-zinc-700 bg-white border border-zinc-300 rounded-lg hover:bg-zinc-50 hover:border-zinc-400 transition-all"
          aria-label="Previous page"
        >
          &larr; Prev
        </a>
      ) : (
        <span
          class="px-3.5 py-2 text-sm font-medium text-zinc-300 bg-zinc-50 border border-zinc-200 rounded-lg cursor-not-allowed"
          aria-hidden="true"
        >
          &larr; Prev
        </span>
      )}

      {pages.map((p) => {
        const url = p === 1 ? '/blog/' : `/blog/page/${p}/`;
        const isCurrent = p === currentPage;

        return isCurrent ? (
          <span
            class="px-4 py-2 text-sm font-bold text-white bg-zinc-900 border border-zinc-900 rounded-lg shadow-sm"
            aria-current="page"
          >
            {p}
          </span>
        ) : (
          <a
            href={url}
            class="craft-button px-4 py-2 text-sm font-medium text-zinc-700 bg-white border border-zinc-300 rounded-lg hover:bg-zinc-50 hover:border-zinc-400 transition-all"
          >
            {p}
          </a>
        );
      })}

      {nextUrl ? (
        <a
          href={nextUrl}
          class="craft-button px-3.5 py-2 text-sm font-medium text-zinc-700 bg-white border border-zinc-300 rounded-lg hover:bg-zinc-50 hover:border-zinc-400 transition-all"
          aria-label="Next page"
        >
          Next &rarr;
        </a>
      ) : (
        <span
          class="px-3.5 py-2 text-sm font-medium text-zinc-300 bg-zinc-50 border border-zinc-200 rounded-lg cursor-not-allowed"
          aria-hidden="true"
        >
          Next &rarr;
        </span>
      )}
    </div>
  </nav>
)}
