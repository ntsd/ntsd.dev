---
interface Props {
  title: string;
  description: string;
  datePublished: Date;
  dateModified?: Date;
  url: string;
  image?: string;
  tags?: string[];
}

const {
  title,
  description,
  datePublished,
  dateModified,
  url,
  image = "https://ntsd.dev/img/me.jpg",
  tags = []
} = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": title,
  "description": description,
  "datePublished": datePublished.toISOString(),
  "dateModified": (dateModified || datePublished).toISOString(),
  "url": url,
  "image": image.startsWith("http") ? image : `https://ntsd.dev${image}`,
  "keywords": tags.join(", "),
  "author": {
    "@type": "Person",
    "name": "Jirawat Boonkumnerd",
    "url": "https://ntsd.dev"
  },
  "publisher": {
    "@type": "Person",
    "name": "Jirawat Boonkumnerd",
    "url": "https://ntsd.dev"
  }
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />

