---
import Social from './Social.astro';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home', match: (p: string) => p === '/' },
  { href: '/blog/', label: 'Blog', match: (p: string) => p.startsWith('/blog') },
  { href: '/projects/', label: 'Projects', match: (p: string) => p.startsWith('/projects') },
  { href: '/tags/', label: 'Tags', match: (p: string) => p.startsWith('/tags') },
  { href: '/categories/', label: 'Categories', match: (p: string) => p.startsWith('/categories') },
  { href: '/about/', label: 'About', match: (p: string) => p.startsWith('/about') },
];
---

<header
  class="sticky top-0 z-50 backdrop-blur-md bg-white/90 border-b border-zinc-200/80"
  id="navbar"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Brand Logo -->
      <a
        href="/"
        class="group inline-flex items-center gap-1.5 min-h-[44px] pr-2 rounded-lg"
        aria-label="ntsd.dev homepage"
      >
        <span translate="no" class="text-xl font-extrabold tracking-tight text-zinc-950 group-hover:text-blue-600 transition-colors">
          ntsd<span class="text-blue-600 font-mono font-semibold">.dev</span>
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1 text-sm font-medium" aria-label="Main Navigation">
        {navLinks.map((link) => {
          const active = link.match(pathname);
          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'inline-flex items-center min-h-[44px] px-3 rounded-lg transition-colors',
                active
                  ? 'text-zinc-950 font-semibold bg-zinc-100'
                  : 'text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100/70',
              ]}
            >
              {link.label}
            </a>
          );
        })}
        <a
          href="https://tools.ntsd.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1 min-h-[44px] px-3 rounded-lg text-zinc-600 hover:text-zinc-950 hover:bg-zinc-100/70 transition-colors"
        >
          <span>Tools</span>
          <svg class="w-3.5 h-3.5 text-zinc-500" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3.5 1.5H10.5V8.5M10.5 1.5L1.5 10.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </nav>

      <!-- Desktop Social & Feed Icons -->
      <div class="hidden md:flex items-center">
        <Social />
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex md:hidden">
        <button
          aria-label="Toggle Navigation Menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          id="nav-toggle"
          type="button"
          class="inline-flex items-center justify-center min-w-[44px] min-h-[44px] text-zinc-700 hover:text-zinc-950 hover:bg-zinc-100 rounded-lg transition-colors"
        >
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              id="menu-open-icon"
              d="M4 6h16M4 12h16M4 18h16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            ></path>
            <path
              id="menu-close-icon"
              class="hidden"
              d="M6 6l12 12M18 6L6 18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <nav
    class="md:hidden mobile-drawer absolute inset-x-0 top-full border-t border-zinc-200 bg-white/95 backdrop-blur-md px-4 py-4 space-y-1 shadow-lg"
    id="mobile-menu"
    data-open="false"
    aria-label="Mobile Navigation"
    inert
  >
    {navLinks.map((link) => {
      const active = link.match(pathname);
      return (
        <a
          href={link.href}
          aria-current={active ? 'page' : undefined}
          class:list={[
            'flex items-center min-h-[44px] px-3 py-2 text-base font-medium rounded-lg transition-colors',
            active
              ? 'text-zinc-950 font-semibold bg-zinc-100'
              : 'text-zinc-700 hover:bg-zinc-100 hover:text-zinc-950',
          ]}
        >
          {link.label}
        </a>
      );
    })}
    <a
      href="https://tools.ntsd.dev"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-between min-h-[44px] px-3 py-2 text-base font-medium text-zinc-700 hover:bg-zinc-100 hover:text-zinc-950 rounded-lg transition-colors"
    >
      <span>Online Tools</span>
      <span aria-hidden="true" class="text-zinc-500">&rarr;</span>
    </a>
    <div class="pt-3 mt-3 border-t border-zinc-200 flex items-center justify-start px-1">
      <Social />
    </div>
  </nav>
</header>

<script is:inline>
  const toggle = document.querySelector("#nav-toggle");
  const menu = document.querySelector("#mobile-menu");
  const openIcon = document.querySelector("#menu-open-icon");
  const closeIcon = document.querySelector("#menu-close-icon");

  if (toggle && menu) {
    const setOpen = (isOpen) => {
      menu.setAttribute("data-open", String(isOpen));
      if (isOpen) {
        menu.removeAttribute("inert");
      } else {
        menu.setAttribute("inert", "");
      }
      toggle.setAttribute("aria-expanded", String(isOpen));
      if (openIcon && closeIcon) {
        openIcon.classList.toggle("hidden", isOpen);
        closeIcon.classList.toggle("hidden", !isOpen);
      }
    };

    toggle.addEventListener("click", () => {
      const currentlyOpen = toggle.getAttribute("aria-expanded") === "true";
      setOpen(!currentlyOpen);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>
