---
import Social from './Social.astro';
---

<header
  class="sticky top-0 z-50 backdrop-blur-md bg-white/85 border-b border-zinc-200/80 transition-all duration-200"
  id="navbar"
>
  <div class="container mx-auto px-4 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Brand Logo -->
      <a
        href="/"
        class="group flex items-center gap-1.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded"
        aria-label="ntsd.dev homepage"
      >
        <span class="text-xl font-extrabold tracking-tight text-zinc-900 group-hover:text-blue-600 transition-colors">
          ntsd<span class="text-blue-600 font-mono font-medium">.dev</span>
        </span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-600" aria-label="Main Navigation">
        <a href="/" class="hover:text-zinc-950 transition-colors py-1">Home</a>
        <a href="/blog/" class="hover:text-zinc-950 transition-colors py-1">Blog</a>
        <a href="/projects/" class="hover:text-zinc-950 transition-colors py-1">Projects</a>
        <a
          href="https://tools.ntsd.dev"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-zinc-950 transition-colors py-1 inline-flex items-center gap-1"
        >
          Tools
          <svg class="w-3 h-3 text-zinc-400" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3.5 1.5H10.5V8.5M10.5 1.5L1.5 10.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/tags/" class="hover:text-zinc-950 transition-colors py-1">Tags</a>
        <a href="/about/" class="hover:text-zinc-950 transition-colors py-1">About</a>
      </nav>

      <!-- Desktop Social & Feed Icons -->
      <div class="hidden md:flex items-center gap-3">
        <Social />
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex md:hidden">
        <button
          aria-label="Toggle Navigation Menu"
          id="nav-toggle"
          type="button"
          class="p-2 text-zinc-600 hover:text-zinc-900 hover:bg-zinc-100 rounded-lg transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600"
        >
          <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
            <path
              id="menu-open-icon"
              d="M4 6h16M4 12h16M4 18h16"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    class="md:hidden hidden border-t border-zinc-200/80 bg-white/95 backdrop-blur-md px-4 py-4 space-y-3"
    id="mobile-menu"
  >
    <a href="/" class="block px-3 py-2 text-base font-medium text-zinc-800 hover:bg-zinc-100 rounded-md">Home</a>
    <a href="/blog/" class="block px-3 py-2 text-base font-medium text-zinc-800 hover:bg-zinc-100 rounded-md">Blog</a>
    <a href="/projects/" class="block px-3 py-2 text-base font-medium text-zinc-800 hover:bg-zinc-100 rounded-md">Projects</a>
    <a
      href="https://tools.ntsd.dev"
      target="_blank"
      rel="noopener noreferrer"
      class="block px-3 py-2 text-base font-medium text-zinc-800 hover:bg-zinc-100 rounded-md"
    >
      Online Tools &rarr;
    </a>
    <a href="/tags/" class="block px-3 py-2 text-base font-medium text-zinc-800 hover:bg-zinc-100 rounded-md">Tags</a>
    <a href="/about/" class="block px-3 py-2 text-base font-medium text-zinc-800 hover:bg-zinc-100 rounded-md">About</a>
    <div class="pt-3 border-t border-zinc-100 flex items-center justify-start gap-4 px-3">
      <Social />
    </div>
  </div>
</header>

<script is:inline>
  const toggle = document.querySelector("#nav-toggle");
  const menu = document.querySelector("#mobile-menu");

  if (toggle && menu) {
    toggle.addEventListener("click", () => {
      menu.classList.toggle("hidden");
    });
  }
</script>
