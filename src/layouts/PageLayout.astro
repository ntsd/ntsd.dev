---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  headerImg?: string;
}

const {
  title,
  description = "A software engineer who loves coding.",
  headerImg
} = Astro.props;
---

<BaseLayout title={title} description={description} image={headerImg}>
  <!-- Page Header -->
  <header class="relative bg-zinc-950 text-white border-b border-zinc-800 overflow-hidden">
    <div class="absolute inset-0 bg-grid-dark pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16 lg:py-20">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight leading-[1.1] text-white mb-4">
          {title}
        </h1>
        {description && (
          <p class="text-base sm:text-lg text-zinc-300 font-normal leading-relaxed">
            {description}
          </p>
        )}
      </div>
    </div>
  </header>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <slot />
  </div>
</BaseLayout>
