---
import BaseLayout from './BaseLayout.astro';

interface Props {
  project: {
    id: string;
    name: string;
    description: string;
    since?: string | number;
    stacks?: string[];
    web?: string;
    github?: string;
    headerImg?: string;
  };
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.name} · Open Source Project`} description={project.description}>
  <!-- Project Header -->
  <header class="bg-zinc-950 text-white border-b border-zinc-800">
    <div class="container mx-auto px-4 lg:px-8 py-16 lg:py-20">
      <div class="max-w-4xl">
        <!-- Stacks Pills -->
        <div class="flex flex-wrap gap-2 mb-4">
          {project.stacks?.map((stack) => (
            <a
              aria-label={`Filter projects by ${stack}`}
              class="text-xs font-mono font-medium py-1 px-3 border border-zinc-700 bg-zinc-900/80 rounded-full hover:border-zinc-500 hover:text-white transition-colors"
              href={`/projects/?filter=${encodeURIComponent(stack.toLowerCase())}`}
              title={stack}
            >
              {stack}
            </a>
          ))}
        </div>

        <!-- Project Title -->
        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-2">
          {project.name}
        </h1>

        <!-- Since Date -->
        {project.since && (
          <div class="text-xs font-mono text-zinc-400 mb-4">
            <span>Since {project.since}</span>
          </div>
        )}

        <!-- Project Description -->
        <p class="text-lg sm:text-xl text-zinc-300 font-normal leading-relaxed mb-8 max-w-3xl">
          {project.description}
        </p>

        <!-- Action Links -->
        <div class="flex flex-wrap items-center gap-4">
          {project.web && (
            <a
              class="craft-button inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-zinc-900 bg-white hover:bg-zinc-100 rounded-lg shadow-sm transition-all"
              href={project.web}
              rel="noopener noreferrer"
              target="_blank"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path fill-rule="evenodd" d="M12 2.25c-5.385 0-9.75 4.365-9.75 9.75s4.365 9.75 9.75 9.75 9.75-4.365 9.75-9.75S17.385 2.25 12 2.25zM6.262 6.072a8.25 8.25 0 1010.562-.766 4.5 4.5 0 01-1.318 1.357L14.25 7.5l.165.33a.809.809 0 01-1.086 1.085l-.604-.302a1.125 1.125 0 00-1.298.21l-.132.131c-.439.44-.439 1.152 0 1.591l.296.296c.256.257.622.374.98.314l1.17-.195c.323-.054.654.036.905.245l1.33 1.108c.32.267.46.694.358 1.1a8.7 8.7 0 01-2.288 4.04l-.723.724a1.125 1.125 0 01-1.298.21l-.153-.076a1.125 1.125 0 01-.622-1.006v-1.089c0-.298-.119-.585-.33-.796l-1.347-1.347a1.125 1.125 0 01-.21-1.298L9.75 12l-1.64-1.64a6 6 0 01-1.676-3.257l-.172-1.03z" clip-rule="evenodd"/>
              </svg>
              <span>Visit Live Site &rarr;</span>
            </a>
          )}
          {project.github && (
            <a
              class="craft-button inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold text-white bg-zinc-900 border border-zinc-700 hover:border-zinc-500 rounded-lg transition-all"
              href={`https://github.com/${project.github}`}
              rel="noopener noreferrer"
              target="_blank"
            >
              <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                <path d="M12.026 2C7.13295 1.99937 2.96183 5.54799 2.17842 10.3779C1.395 15.2079 4.23061 19.893 8.87302 21.439C9.37302 21.529 9.55202 21.222 9.55202 20.958C9.55202 20.721 9.54402 20.093 9.54102 19.258C6.76602 19.858 6.18002 17.92 6.18002 17.92C5.99733 17.317 5.60459 16.7993 5.07302 16.461C4.17302 15.842 5.14202 15.856 5.14202 15.856C5.78269 15.9438 6.34657 16.3235 6.66902 16.884C6.94195 17.3803 7.40177 17.747 7.94632 17.9026C8.49087 18.0583 9.07503 17.99 9.56902 17.713C9.61544 17.207 9.84055 16.7341 10.204 16.379C7.99002 16.128 5.66202 15.272 5.66202 11.449C5.64973 10.4602 6.01691 9.5043 6.68802 8.778C6.38437 7.91731 6.42013 6.97325 6.78802 6.138C6.78802 6.138 7.62502 5.869 9.53002 7.159C11.1639 6.71101 12.8882 6.71101 14.522 7.159C16.428 5.868 17.264 6.138 17.264 6.138C17.6336 6.97286 17.6694 7.91757 17.364 8.778C18.0376 9.50423 18.4045 10.4626 18.388 11.453C18.388 15.286 16.058 16.128 13.836 16.375C14.3153 16.8651 14.5612 17.5373 14.511 18.221C14.511 19.555 14.499 20.631 14.499 20.958C14.499 21.225 14.677 21.535 15.186 21.437C19.8265 19.8884 22.6591 15.203 21.874 10.3743C21.089 5.54565 16.9181 1.99888 12.026 2Z"/>
              </svg>
              <span>GitHub Repository</span>
            </a>
          )}
        </div>
      </div>
    </div>
  </header>

  <!-- Project README Slot -->
  <div class="container mx-auto px-4 lg:px-8 py-12 lg:py-16">
    <div class="max-w-4xl mx-auto">
      <div class="prose prose-zinc lg:prose-lg max-w-none prose-headings:scroll-mt-24 prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600 hover:prose-a:underline prose-pre:border prose-pre:border-zinc-800 prose-img:rounded-xl prose-img:shadow-sm">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>
