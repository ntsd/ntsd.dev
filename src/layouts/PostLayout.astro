---
import BaseLayout from './BaseLayout.astro';
import Giscus from '../components/Giscus.astro';
import TOC from '../components/TOC.astro';
import SchemaOrg from '../components/SchemaOrg.astro';

interface Props {
  post: {
    title: string;
    description?: string;
    date: Date;
    headerImg?: string;
    categories?: string[];
    tags?: string[];
    catalog?: boolean;
  };
  prevPost?: { url: string; title: string };
  nextPost?: { url: string; title: string };
  headings?: { depth: number; slug: string; text: string }[];
}

const { post, prevPost, nextPost, headings = [] } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const formattedDate = post.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const showCatalog = Boolean(post.catalog) && headings.length > 0;
---

<BaseLayout
  title={post.title}
  description={post.description}
  image={post.headerImg}
  type="article"
>
  <Fragment slot="head">
    <SchemaOrg
      title={post.title}
      description={post.description || ""}
      datePublished={post.date}
      url={canonicalUrl}
      image={post.headerImg}
      tags={post.tags}
    />
  </Fragment>

  <!-- Post Header -->
  <header class="relative bg-zinc-950 text-white border-b border-zinc-800 overflow-hidden">
    <div class="absolute inset-0 bg-grid-dark pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16 lg:py-24">
      <div class:list={[showCatalog ? "max-w-4xl" : "max-w-3xl mx-auto"]}>
        <!-- Back Link -->
        <div class="mb-6">
          <a
            href="/blog/"
            class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-zinc-400 hover:text-white transition-colors min-h-[44px]"
          >
            <span aria-hidden="true">&larr;</span>
            <span>All Articles</span>
          </a>
        </div>

        <!-- Categories & Tags -->
        {(post.categories?.length || post.tags?.length) && (
          <div class="flex flex-wrap items-center gap-2 mb-6">
            {post.categories?.map((cat) => (
              <a
                class="inline-flex items-center text-xs font-mono font-medium py-1 px-3 border border-zinc-700 bg-zinc-900 text-zinc-200 rounded-full hover:border-zinc-500 hover:text-white transition-colors"
                href={`/categories/#${encodeURIComponent(cat)}`}
                title={cat}
              >
                {cat}
              </a>
            ))}
            {post.tags?.map((tag) => (
              <a
                class="inline-flex items-center text-xs font-mono font-medium py-1 px-2 text-zinc-400 hover:text-white transition-colors"
                href={`/tags/#${encodeURIComponent(tag)}`}
                title={tag}
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        <!-- Post Title -->
        <h1 class="text-3xl sm:text-5xl lg:text-[3.25rem] font-extrabold tracking-tight leading-[1.1] mb-6 text-white">
          {post.title}
        </h1>

        <!-- Post Description -->
        {post.description && (
          <p class="text-lg sm:text-xl text-zinc-300 font-normal leading-relaxed mb-8">
            {post.description}
          </p>
        )}

        <!-- Author & Date -->
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono text-zinc-400 pt-6 border-t border-zinc-800">
          <span class="text-zinc-200 font-medium">Jirawat Boonkumnerd</span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={post.date.toISOString().split("T")[0]}>
            {formattedDate}
          </time>
        </div>
      </div>
    </div>
  </header>

  <!-- Main Article Content -->
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class:list={[
      showCatalog ? "grid grid-cols-12 gap-8 lg:gap-12" : "max-w-3xl mx-auto"
    ]}>
      <article class:list={[showCatalog ? "col-span-12 lg:col-span-8 min-w-0" : "w-full min-w-0"]}>
        <div class="prose prose-zinc lg:prose-lg max-w-none prose-headings:scroll-mt-24 prose-headings:font-bold prose-headings:tracking-tight prose-a:text-blue-600 prose-a:no-underline hover:prose-a:underline prose-pre:border prose-pre:border-zinc-800 prose-img:rounded-xl prose-img:border prose-img:border-zinc-200">
          <slot />
        </div>

        <!-- Previous / Next Navigation -->
        <nav aria-label="Article navigation" class="grid grid-cols-1 sm:grid-cols-2 mt-16 gap-6 border-t border-zinc-200 pt-10">
          {prevPost ? (
            <a
              href={prevPost.url}
              class="craft-card block border border-zinc-200 bg-white p-5 rounded-xl hover:border-zinc-300 shadow-xs text-left group"
            >
              <div class="text-xs font-mono font-medium text-zinc-600 group-hover:text-blue-600 transition-colors uppercase tracking-wider">
                &larr; Previous
              </div>
              <div class="font-bold text-zinc-950 group-hover:text-blue-600 transition-colors mt-1.5 line-clamp-2">
                {prevPost.title}
              </div>
            </a>
          ) : <div class="hidden sm:block" />}

          {nextPost ? (
            <a
              href={nextPost.url}
              class="craft-card block border border-zinc-200 bg-white p-5 rounded-xl hover:border-zinc-300 shadow-xs text-right group"
            >
              <div class="text-xs font-mono font-medium text-zinc-600 group-hover:text-blue-600 transition-colors uppercase tracking-wider">
                Next &rarr;
              </div>
              <div class="font-bold text-zinc-950 group-hover:text-blue-600 transition-colors mt-1.5 line-clamp-2">
                {nextPost.title}
              </div>
            </a>
          ) : <div class="hidden sm:block" />}
        </nav>

        <!-- Giscus Discussion Embed -->
        <section class="mt-16 pt-10 border-t border-zinc-200" aria-label="Article discussion">
          <Giscus />
        </section>
      </article>

      <!-- Table of Contents Sidebar -->
      {showCatalog && (
        <aside class="hidden lg:block col-span-4">
          <div class="sticky top-24 bg-white border border-zinc-200 rounded-xl p-6 shadow-xs">
            <h2 class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-600 mb-4">
              On This Page
            </h2>
            <TOC headings={headings} />
          </div>
        </aside>
      )}
    </div>
  </div>

  <!-- Reading Progress Bar -->
  <div id="read-progress" role="presentation" aria-hidden="true"></div>

  <script is:inline>
    const progress = document.getElementById("read-progress");
    let ticking = false;
    const updateProgress = () => {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      if (progress && total > 0) {
        const ratio = Math.min(1, Math.max(0, window.scrollY / total));
        progress.style.transform = `scaleX(${ratio})`;
      }
      ticking = false;
    };
    window.addEventListener(
      "scroll",
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(updateProgress);
        }
      },
      { passive: true }
    );
  </script>
</BaseLayout>
