---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="About Me"
  description="Software Engineer & Distributed Systems Practitioner"
>
  <div class="max-w-3xl mx-auto py-8">
    <!-- About Section -->
    <section id="about" class="mb-16">
      <div class="prose prose-zinc lg:prose-lg max-w-none text-zinc-700 leading-relaxed mb-10">
        <p class="text-xl font-bold text-zinc-950 mb-4">Hello!</p>
        <p>
          I am <strong>Jirawat Boonkumnerd (Jo)</strong>, a Software Engineer from Thailand passionate about systems programming, distributed consensus, network performance, and developer tooling.
        </p>
        <p>
          I focus heavily on building lean, high-throughput architectures using Go, TypeScript, WebRTC, and Astro. On this blog, I write deep dives into low-level mechanics like PostgreSQL B-Tree vs. Hash indexing, Node stream piping, and client-side P2P protocols.
        </p>
      </div>

      <!-- Quick Facts Card -->
      <div class="craft-card bg-white border border-zinc-200/80 rounded-xl p-6 lg:p-7 shadow-sm max-w-lg">
        <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-zinc-600 mb-4">
          Quick Bio
        </h3>
        <table class="w-full text-sm">
          <tbody class="divide-y divide-zinc-100">
            <tr>
              <td class="py-2.5 font-mono text-xs text-zinc-500 w-28">Name</td>
              <td class="py-2.5 font-medium text-zinc-900">Jirawat Boonkumnerd</td>
            </tr>
            <tr>
              <td class="py-2.5 font-mono text-xs text-zinc-500">Email</td>
              <td class="py-2.5">
                <a class="text-blue-600 hover:underline font-mono text-xs" href="mailto:contact@ntsd.dev">
                  contact@ntsd.dev
                </a>
              </td>
            </tr>
            <tr>
              <td class="py-2.5 font-mono text-xs text-zinc-500">Website</td>
              <td class="py-2.5">
                <a class="text-blue-600 hover:underline font-mono text-xs" href="https://ntsd.dev">
                  ntsd.dev
                </a>
              </td>
            </tr>
            <tr>
              <td class="py-2.5 font-mono text-xs text-zinc-500">Location</td>
              <td class="py-2.5 text-zinc-900">Bangkok, Thailand</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <hr class="border-zinc-200/80 my-12" />

    <!-- Contact Section -->
    <section id="contact">
      <h2 class="text-3xl font-bold tracking-tight text-zinc-950 mb-3">Get in Touch</h2>
      <p class="text-zinc-600 mb-8 leading-relaxed">
        Feel free to reach out for technical discussions, open-source collaborations, or consulting inquiries.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        <a
          href="https://github.com/ntsd"
          rel="noopener noreferrer"
          target="_blank"
          class="craft-card p-4 rounded-xl border border-zinc-200/80 bg-white hover:border-zinc-300 shadow-sm flex items-center gap-3.5 group"
        >
          <div class="p-2.5 rounded-lg bg-zinc-100 text-zinc-800 group-hover:bg-zinc-900 group-hover:text-white transition-colors">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M12.026 2C7.13295 1.99937 2.96183 5.54799 2.17842 10.3779C1.395 15.2079 4.23061 19.893 8.87302 21.439C9.37302 21.529 9.55202 21.222 9.55202 20.958C9.55202 20.721 9.54402 20.093 9.54102 19.258C6.76602 19.858 6.18002 17.92 6.18002 17.92C5.99733 17.317 5.60459 16.7993 5.07302 16.461C4.17302 15.842 5.14202 15.856 5.14202 15.856C5.78269 15.9438 6.34657 16.3235 6.66902 16.884C6.94195 17.3803 7.40177 17.747 7.94632 17.9026C8.49087 18.0583 9.07503 17.99 9.56902 17.713C9.61544 17.207 9.84055 16.7341 10.204 16.379C7.99002 16.128 5.66202 15.272 5.66202 11.449C5.64973 10.4602 6.01691 9.5043 6.68802 8.778C6.38437 7.91731 6.42013 6.97325 6.78802 6.138C6.78802 6.138 7.62502 5.869 9.53002 7.159C11.1639 6.71101 12.8882 6.71101 14.522 7.159C16.428 5.868 17.264 6.138 17.264 6.138C17.6336 6.97286 17.6694 7.91757 17.364 8.778C18.0376 9.50423 18.4045 10.4626 18.388 11.453C18.388 15.286 16.058 16.128 13.836 16.375C14.3153 16.8651 14.5612 17.5373 14.511 18.221C14.511 19.555 14.499 20.631 14.499 20.958C14.499 21.225 14.677 21.535 15.186 21.437C19.8265 19.8884 22.6591 15.203 21.874 10.3743C21.089 5.54565 16.9181 1.99888 12.026 2Z"></path>
            </svg>
          </div>
          <div>
            <div class="text-xs font-mono text-zinc-600">GitHub</div>
            <div class="text-sm font-semibold text-zinc-900 group-hover:text-blue-600 transition-colors">github.com/ntsd</div>
          </div>
        </a>

        <a
          href="https://www.linkedin.com/in/ntsd"
          rel="noopener noreferrer"
          target="_blank"
          class="craft-card p-4 rounded-xl border border-zinc-200/80 bg-white hover:border-zinc-300 shadow-sm flex items-center gap-3.5 group"
        >
          <div class="p-2.5 rounded-lg bg-zinc-100 text-zinc-800 group-hover:bg-blue-600 group-hover:text-white transition-colors">
            <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></path>
            </svg>
          </div>
          <div>
            <div class="text-xs font-mono text-zinc-600">LinkedIn</div>
            <div class="text-sm font-semibold text-zinc-900 group-hover:text-blue-600 transition-colors">linkedin.com/in/ntsd</div>
          </div>
        </a>
      </div>

      <a
        aria-label="Email"
        href="mailto:contact@ntsd.dev"
        class="craft-button inline-flex items-center gap-2 bg-zinc-900 hover:bg-zinc-800 text-white font-medium py-3 px-6 rounded-lg shadow-sm transition-all text-sm"
        rel="noopener noreferrer"
        target="_blank"
      >
        <span>Send Email to contact@ntsd.dev</span>
        <span>&rarr;</span>
      </a>
    </section>
  </div>
</PageLayout>
