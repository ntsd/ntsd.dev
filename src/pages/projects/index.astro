---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';

const allProjects = await getCollection('projects');
const featured = allProjects.filter((p) => p.data.featured);
const regular = allProjects.filter((p) => !p.data.featured);
const projects = [...featured, ...regular];

const filterOptions = [
  { key: '', label: 'All' },
  { key: 'featured', label: 'Featured' },
  { key: 'golang', label: 'Golang' },
  { key: 'typescript', label: 'TypeScript' },
  { key: 'webrtc', label: 'WebRTC' },
  { key: 'astro', label: 'Astro' },
  { key: 'svelte', label: 'Svelte' },
  { key: 'python', label: 'Python' },
  { key: 'swift', label: 'Swift' },
];
---

<PageLayout
  title="Open Source Projects"
  description="Distributed systems, networking protocols, WebRTC engines, and developer utilities."
>
  <!-- Quick Filter Chips -->
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8 pb-6 border-b border-zinc-200">
    <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Filter projects by stack">
      <span class="text-xs font-mono font-semibold text-zinc-600 uppercase tracking-wider mr-1">Filter:</span>
      {filterOptions.map((opt) => (
        <a
          href={opt.key ? `/projects/?filter=${encodeURIComponent(opt.key)}` : '/projects/'}
          data-filter={opt.key}
          class="filter-chip craft-button inline-flex items-center justify-center min-h-[44px] px-3.5 py-2 text-xs font-mono font-medium rounded-lg border border-zinc-300 bg-white hover:bg-zinc-50 text-zinc-800"
        >
          {opt.label}
        </a>
      ))}
    </div>
    <p class="font-mono text-xs text-zinc-600 tabular-nums" id="projects-count" aria-live="polite">
      Showing {projects.length} of {projects.length} projects
    </p>
  </div>

  <!-- Active Filter Alert -->
  <div id="filter-banner" class="hidden mb-8 p-4 bg-white border border-zinc-300 rounded-xl flex flex-wrap items-center justify-between gap-3 shadow-xs">
    <span class="text-sm font-medium text-zinc-900" id="filter-text"></span>
    <a
      href="/projects/"
      id="clear-filter-btn"
      class="inline-flex items-center min-h-[44px] px-3 text-xs font-mono font-semibold text-blue-600 hover:text-blue-700 hover:bg-blue-50 rounded-md transition-colors"
    >
      Clear filter &times;
    </a>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8" id="projects-grid">
    {projects.map((project) => (
      <ProjectCard project={project.data} />
    ))}
  </div>

  <!-- Empty Filter State -->
  <div id="projects-empty" class="hidden text-center py-16 px-6 bg-white border border-zinc-200 rounded-2xl">
    <p class="text-lg font-bold text-zinc-950 mb-2">No matching projects found</p>
    <p class="text-sm text-zinc-600 mb-6">Try clearing the active filter to browse all open-source systems.</p>
    <a
      href="/projects/"
      id="empty-reset-btn"
      class="craft-button inline-flex items-center justify-center min-h-[44px] px-5 py-2.5 text-sm font-semibold text-white bg-zinc-950 hover:bg-zinc-800 rounded-lg"
    >
      Show All Projects
    </a>
  </div>

  <script is:inline>
    (() => {
      const chips = Array.from(document.querySelectorAll(".filter-chip"));
      const cards = Array.from(document.querySelectorAll(".project-card"));
      const banner = document.getElementById("filter-banner");
      const filterText = document.getElementById("filter-text");
      const countEl = document.getElementById("projects-count");
      const emptyEl = document.getElementById("projects-empty");
      const clearBtn = document.getElementById("clear-filter-btn");
      const emptyResetBtn = document.getElementById("empty-reset-btn");
      const total = cards.length;

      const applyFilter = (rawFilter, updateUrl = false) => {
        const filter = (rawFilter || "").trim();
        const normalized = filter.toLowerCase().replace(/[^a-z0-9_-]/g, "");

        let visible = 0;
        cards.forEach((card) => {
          const matches = !normalized || card.className.toLowerCase().includes(normalized);
          card.style.display = matches ? "" : "none";
          if (matches) visible += 1;
        });

        chips.forEach((chip) => {
          const chipKey = chip.getAttribute("data-filter") || "";
          const isActive = chipKey === normalized;
          chip.setAttribute("aria-pressed", String(isActive));
          if (isActive) {
            chip.classList.add("bg-zinc-950", "text-white", "border-zinc-950", "hover:bg-zinc-800");
            chip.classList.remove("bg-white", "text-zinc-800", "border-zinc-300", "hover:bg-zinc-50");
          } else {
            chip.classList.remove("bg-zinc-950", "text-white", "border-zinc-950", "hover:bg-zinc-800");
            chip.classList.add("bg-white", "text-zinc-800", "border-zinc-300", "hover:bg-zinc-50");
          }
        });

        if (banner && filterText) {
          if (normalized) {
            banner.classList.remove("hidden");
            filterText.textContent = `Showing ${visible} ${visible === 1 ? "project" : "projects"} matching "${filter}"`;
          } else {
            banner.classList.add("hidden");
          }
        }

        if (countEl) {
          countEl.textContent = `Showing ${visible} of ${total} projects`;
        }

        if (emptyEl) {
          emptyEl.classList.toggle("hidden", visible > 0);
        }

        if (updateUrl) {
          const nextUrl = normalized ? `/projects/?filter=${encodeURIComponent(normalized)}` : "/projects/";
          window.history.replaceState({}, "", nextUrl);
        }
      };

      chips.forEach((chip) => {
        chip.addEventListener("click", (e) => {
          e.preventDefault();
          applyFilter(chip.getAttribute("data-filter") || "", true);
        });
      });

      [clearBtn, emptyResetBtn].forEach((btn) => {
        if (!btn) return;
        btn.addEventListener("click", (e) => {
          e.preventDefault();
          applyFilter("", true);
        });
      });

      const initialFilter = new URLSearchParams(window.location.search).get("filter") || "";
      applyFilter(initialFilter, false);
    })();
  </script>
</PageLayout>
