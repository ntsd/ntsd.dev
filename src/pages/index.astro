---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentPosts = allPosts.slice(0, 4);

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.filter((p) => p.data.featured);

const uniqueTags = new Set<string>();
for (const post of allPosts) {
  for (const tag of post.data.tags || []) {
    uniqueTags.add(tag);
  }
}
---

<BaseLayout
  title="Jirawat Boonkumnerd · Software Engineer"
  description="Software engineer building distributed systems, WebRTC protocols, and zero-overhead web architectures."
>
  <!-- Hero Section (First Screen) -->
  <section class="relative overflow-hidden border-b border-zinc-200 bg-white">
    <div
      class="absolute inset-0 bg-grid-light opacity-50 pointer-events-none"
      style="mask-image: linear-gradient(to bottom, rgba(0,0,0,0.85), rgba(0,0,0,0)); -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.85), rgba(0,0,0,0));"
      aria-hidden="true"
    ></div>

    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-28">
      <div class="max-w-4xl">
        <!-- Main Authority Headline -->
        <h1 class="hero-enter text-4xl sm:text-6xl lg:text-[4.25rem] font-extrabold text-zinc-950 tracking-tight leading-[1.06] mb-6">
          Building distributed systems, protocols, and zero-overhead web architectures.
        </h1>

        <p class="hero-enter text-lg sm:text-xl text-zinc-600 font-normal leading-relaxed max-w-2xl mb-10">
          I'm Jirawat Boonkumnerd (Jo), a software engineer in Bangkok. I write technical analyses on Go concurrency, PostgreSQL index internals, WebRTC peer-to-peer data channels, and lean static infrastructure.
        </p>

        <!-- Action Buttons -->
        <div class="hero-enter flex flex-wrap items-center gap-4 mb-14">
          <a
            href="/blog/"
            class="craft-button inline-flex items-center justify-center gap-2 min-h-[48px] px-6 py-3 text-sm font-semibold text-white bg-zinc-950 hover:bg-zinc-800 rounded-lg shadow-xs"
          >
            <span>Browse Articles</span>
            <span aria-hidden="true" class="craft-arrow inline-block">&rarr;</span>
          </a>
          <a
            href="/projects/"
            class="craft-button inline-flex items-center justify-center min-h-[48px] px-6 py-3 text-sm font-semibold text-zinc-900 bg-white border border-zinc-300 hover:bg-zinc-50 hover:border-zinc-400 rounded-lg"
          >
            Explore Projects
          </a>
        </div>

        <!-- Work Highlights Strip -->
        <div class="hero-enter pt-8 border-t border-zinc-200 grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8">
          <a
            href="/blog/"
            class="group flex items-baseline gap-3.5 rounded-lg p-2 -m-2 hover:bg-zinc-50 transition-colors"
          >
            <span class="font-mono tabular-nums text-3xl font-extrabold text-zinc-950 group-hover:text-blue-600 transition-colors">
              {allPosts.length}
            </span>
            <div class="flex flex-col">
              <span class="text-xs font-mono font-semibold text-zinc-900 group-hover:text-blue-600 transition-colors flex items-center gap-1">
                Technical Articles
                <span aria-hidden="true" class="craft-arrow inline-block text-zinc-500 group-hover:text-blue-600">&rarr;</span>
              </span>
              <span class="text-xs text-zinc-600">Deep dives &amp; benchmarks</span>
            </div>
          </a>

          <a
            href="/projects/"
            class="group flex items-baseline gap-3.5 rounded-lg p-2 -m-2 hover:bg-zinc-50 transition-colors"
          >
            <span class="font-mono tabular-nums text-3xl font-extrabold text-zinc-950 group-hover:text-blue-600 transition-colors">
              {allProjects.length}
            </span>
            <div class="flex flex-col">
              <span class="text-xs font-mono font-semibold text-zinc-900 group-hover:text-blue-600 transition-colors flex items-center gap-1">
                Open Source Systems
                <span aria-hidden="true" class="craft-arrow inline-block text-zinc-500 group-hover:text-blue-600">&rarr;</span>
              </span>
              <span class="text-xs text-zinc-600">Tools, WebRTC &amp; protocols</span>
            </div>
          </a>

          <a
            href="/tags/"
            class="group flex items-baseline gap-3.5 rounded-lg p-2 -m-2 hover:bg-zinc-50 transition-colors"
          >
            <span class="font-mono tabular-nums text-3xl font-extrabold text-zinc-950 group-hover:text-blue-600 transition-colors">
              {uniqueTags.size}
            </span>
            <div class="flex flex-col">
              <span class="text-xs font-mono font-semibold text-zinc-900 group-hover:text-blue-600 transition-colors flex items-center gap-1">
                Topics Covered
                <span aria-hidden="true" class="craft-arrow inline-block text-zinc-500 group-hover:text-blue-600">&rarr;</span>
              </span>
              <span class="text-xs text-zinc-600">Go, databases &amp; networking</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Latest Articles Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
      <div>
        <h2 class="text-3xl font-extrabold tracking-tight text-zinc-950">
          Latest Technical Articles
        </h2>
        <p class="text-sm text-zinc-600 mt-1.5">Deep dives, benchmarks, and practical engineering guides.</p>
      </div>
      <a
        href="/blog/"
        class="inline-flex items-center gap-1 min-h-[44px] text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors self-start sm:self-auto"
      >
        <span>View all articles</span>
        <span aria-hidden="true" class="craft-arrow inline-block">&rarr;</span>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
      {recentPosts.map((post) => {
        const slug = post.id.replace(/^\d{4}-\d{1,2}-\d{1,2}-/, '');
        const formattedDate = post.data.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'short',
          day: 'numeric',
        });

        return (
          <article class="craft-card bg-white border border-zinc-200 hover:border-zinc-300 rounded-xl p-6 lg:p-7 shadow-xs hover:shadow-md flex flex-col justify-between group">
            <div>
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3">
                <time
                  datetime={post.data.date.toISOString().split('T')[0]}
                  class="font-mono text-xs font-medium text-zinc-600"
                >
                  {formattedDate}
                </time>
                <div class="flex flex-wrap gap-1.5">
                  {post.data.categories?.map((category) => (
                    <a
                      href={`/categories/#${encodeURIComponent(category)}`}
                      class="px-2.5 py-0.5 text-xs font-mono font-medium text-zinc-700 bg-zinc-100 hover:bg-zinc-200 border border-zinc-200 rounded-full transition-colors"
                      title={category}
                    >
                      {category}
                    </a>
                  ))}
                </div>
              </div>

              <a href={`/${slug}/`} class="block group/title mt-1 rounded-md">
                <h3 class="text-xl font-bold tracking-tight text-zinc-950 group-hover/title:text-blue-600 transition-colors leading-snug">
                  {post.data.title}
                </h3>
                {post.data.description && (
                  <p class="mt-2.5 text-sm text-zinc-600 line-clamp-2 leading-relaxed">
                    {post.data.description}
                  </p>
                )}
              </a>
            </div>

            <div class="mt-6 pt-5 border-t border-zinc-100 flex items-center justify-between gap-4">
              <div class="flex flex-wrap gap-2 text-xs font-mono text-zinc-600">
                {post.data.tags?.slice(0, 3).map((tag) => (
                  <a href={`/tags/#${encodeURIComponent(tag)}`} class="hover:text-zinc-950 transition-colors">
                    #{tag}
                  </a>
                ))}
              </div>
              <a
                href={`/${slug}/`}
                class="text-xs font-semibold text-blue-600 hover:text-blue-700 inline-flex items-center gap-1 shrink-0"
              >
                <span>Read</span>
                <span aria-hidden="true" class="craft-arrow inline-block">&rarr;</span>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- Featured Projects Section -->
  <section class="border-t border-zinc-200 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <h2 class="text-3xl font-extrabold tracking-tight text-zinc-950">
            Featured Projects
          </h2>
          <p class="text-sm text-zinc-600 mt-1.5">Distributed tools, WebRTC engines, and developer utilities.</p>
        </div>
        <a
          href="/projects/"
          class="inline-flex items-center gap-1 min-h-[44px] text-sm font-semibold text-blue-600 hover:text-blue-700 transition-colors self-start sm:self-auto"
        >
          <span>View all projects</span>
          <span aria-hidden="true" class="craft-arrow inline-block">&rarr;</span>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
        {featuredProjects.map((project) => (
          <ProjectCard project={project.data} />
        ))}
      </div>
    </div>
  </section>

  <!-- Closing Band -->
  <section class="relative bg-zinc-950 text-white border-t border-zinc-800 overflow-hidden">
    <div class="absolute inset-0 bg-grid-dark pointer-events-none" aria-hidden="true"></div>
    <div class="relative max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-20">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
        <div class="max-w-2xl">
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white mb-3">
            Want to discuss systems architecture or open-source tooling?
          </h2>
          <p class="text-base text-zinc-300 leading-relaxed">
            Reach out for engineering collaborations, performance audits, or technical discussions.
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-4 shrink-0">
          <a
            href="/about/#contact"
            class="craft-button inline-flex items-center justify-center gap-2 min-h-[48px] px-6 py-3 text-sm font-semibold text-zinc-950 bg-white hover:bg-zinc-100 rounded-lg shadow-xs"
          >
            <span>Get in Touch</span>
            <span aria-hidden="true" class="craft-arrow inline-block">&rarr;</span>
          </a>
          <a
            href="https://github.com/ntsd"
            target="_blank"
            rel="noopener noreferrer"
            class="craft-button inline-flex items-center justify-center min-h-[48px] px-6 py-3 text-sm font-semibold text-white bg-zinc-900 border border-zinc-700 hover:border-zinc-500 hover:bg-zinc-800 rounded-lg"
          >
            View GitHub
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
