---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Page Not Found"
  description="The requested route does not exist or may have moved."
>
  <div class="max-w-xl bg-white border border-zinc-200 rounded-2xl p-8 sm:p-10 shadow-xs">
    <p class="font-mono text-5xl font-extrabold text-zinc-950 tracking-tight mb-4">404</p>
    <h2 class="text-xl font-bold text-zinc-950 mb-3">Route Not Found</h2>
    <p class="text-zinc-600 mb-8 leading-relaxed">
      The page you requested could not be found. It may have been moved, renamed, or is temporarily unavailable.
    </p>
    <div class="flex flex-wrap gap-3">
      <a
        href="/"
        class="craft-button inline-flex items-center justify-center min-h-[44px] px-6 py-2.5 bg-zinc-950 text-white font-semibold text-sm rounded-lg hover:bg-zinc-800 shadow-xs"
      >
        Go to Home
      </a>
      <a
        href="/blog/"
        class="craft-button inline-flex items-center justify-center min-h-[44px] px-6 py-2.5 bg-white border border-zinc-300 text-zinc-900 font-semibold text-sm rounded-lg hover:bg-zinc-50 hover:border-zinc-400"
      >
        Browse Blog
      </a>
    </div>
  </div>
</PageLayout>
