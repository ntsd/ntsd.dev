---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="404 - Not Found"
  description="Page Not Found"
>
  <div class="max-w-xl mx-auto py-16 text-center">
    <div class="text-7xl font-extrabold text-gray-900 mb-4">404</div>
    <h2 class="text-2xl font-bold text-gray-800 mb-3">Page Not Found</h2>
    <p class="text-gray-600 mb-8 leading-relaxed">
      The page you requested could not be found. It may have been moved, renamed, or is temporarily unavailable.
    </p>
    <div class="flex justify-center gap-4">
      <a
        href="/"
        class="inline-block px-6 py-2.5 bg-gray-900 text-white font-medium text-sm rounded hover:bg-gray-800 transition-colors"
      >
        Go to Home
      </a>
      <a
        href="/blog/"
        class="inline-block px-6 py-2.5 bg-white border border-gray-300 text-gray-700 font-medium text-sm rounded hover:bg-gray-50 transition-colors"
      >
        Browse Blog
      </a>
    </div>
  </div>
</PageLayout>

