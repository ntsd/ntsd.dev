---
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const allPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

// Map categories to posts
const categoryMap = new Map<string, typeof allPosts>();

for (const post of allPosts) {
  for (const cat of post.data.categories || []) {
    const existing = categoryMap.get(cat) || [];
    existing.push(post);
    categoryMap.set(cat, existing);
  }
}

const sortedCategories = Array.from(categoryMap.keys()).sort((a, b) =>
  a.localeCompare(b)
);
---

<PageLayout
  title="Categories"
  description="Technical articles organized by engineering domain and systems architecture."
>
  <div class="max-w-4xl">
    <!-- Quick Jump Chips -->
    <div class="flex flex-wrap gap-2.5 p-6 bg-white rounded-2xl border border-zinc-200 shadow-xs mb-12">
      {sortedCategories.map((category) => {
        const count = categoryMap.get(category)?.length || 0;
        return (
          <a
            href={`#${encodeURIComponent(category)}`}
            class="craft-button inline-flex items-center gap-1.5 min-h-[44px] px-3.5 py-2 font-mono text-sm font-medium text-zinc-800 bg-zinc-50 hover:bg-zinc-100 border border-zinc-200 hover:border-zinc-400 hover:text-blue-600 rounded-lg"
          >
            <span>{category}</span>
            <span class="text-xs text-zinc-600">({count})</span>
          </a>
        );
      })}
    </div>

    <div class="space-y-8">
      {sortedCategories.map((category) => {
        const posts = categoryMap.get(category) || [];

        return (
          <section class="scroll-mt-24 bg-white border border-zinc-200 rounded-xl p-6 lg:p-7 shadow-xs" id={category}>
            <div class="flex items-center justify-between border-b border-zinc-100 pb-3 mb-2">
              <h2 class="text-xl font-bold tracking-tight text-zinc-950 font-mono">
                {category}
              </h2>
              <span class="text-xs font-mono text-zinc-600">
                {posts.length} {posts.length === 1 ? 'article' : 'articles'}
              </span>
            </div>

            <ul class="divide-y divide-zinc-100">
              {posts.map((post) => {
                const slug = post.id.replace(/^\d{4}-\d{1,2}-\d{1,2}-/, '');
                const isoDate = post.data.date.toISOString().split('T')[0];

                return (
                  <li>
                    <a
                      href={`/${slug}/`}
                      class="flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-4 py-3.5 -mx-3 px-3 rounded-lg hover:bg-zinc-50 transition-colors group"
                    >
                      <time
                        datetime={isoDate}
                        class="text-xs font-mono text-zinc-600 whitespace-nowrap shrink-0"
                      >
                        {isoDate}
                      </time>
                      <span class="text-base text-zinc-900 group-hover:text-blue-600 font-semibold transition-colors">
                        {post.data.title}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        );
      })}
    </div>
  </div>
</PageLayout>
