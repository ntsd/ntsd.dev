---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Offline"
  description="You appear to be offline."
>
  <div class="max-w-xl bg-white border border-zinc-200 rounded-2xl p-8 sm:p-10 shadow-xs">
    <div class="w-12 h-12 rounded-xl bg-zinc-100 border border-zinc-200 flex items-center justify-center text-zinc-700 mb-6">
      <svg class="w-6 h-6 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.75" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
      </svg>
    </div>
    <h2 class="text-xl font-bold text-zinc-950 mb-3">No Internet Connection</h2>
    <p class="text-zinc-600 mb-8 leading-relaxed">
      You are currently viewing an offline version of this site. Articles and pages you have previously visited are stored in your device cache and remain readable.
    </p>
    <a
      href="/"
      class="craft-button inline-flex items-center justify-center min-h-[44px] px-6 py-2.5 bg-zinc-950 text-white font-semibold text-sm rounded-lg hover:bg-zinc-800 shadow-xs"
    >
      Return to Home
    </a>
  </div>
</PageLayout>
