---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout
  title="Offline"
  description="You appear to be offline."
>
  <div class="max-w-xl mx-auto py-16 text-center">
    <div class="w-16 h-16 mx-auto mb-6 text-gray-400">
      <svg class="w-full h-full fill-none stroke-current" viewBox="0 0 24 24" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
      </svg>
    </div>
    <h2 class="text-2xl font-bold text-gray-900 mb-3">No Internet Connection</h2>
    <p class="text-gray-600 mb-8 leading-relaxed">
      You are currently viewing an offline version of this site. Articles and pages you have previously visited are stored in your device cache and remain readable.
    </p>
    <a
      href="/"
      class="inline-block px-6 py-2.5 bg-gray-900 text-white font-medium text-sm rounded hover:bg-gray-800 transition-colors"
    >
      Return to Home
    </a>
  </div>
</PageLayout>

